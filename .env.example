# PersonaLive 本地基础设施配置。
# 本文件可复制为 .env；.env 已被 Git 忽略，禁止提交密码或 Provider Key。
# LLM、Embedding 与联网搜索配置在 Web 工作台的“设置”页保存到
# data/local_settings.json，不在本文件配置。

# ===== Milvus 向量数据库 =====
# Docker 默认暴露在 19530；若同时运行多个副本，必须与 docker-compose.yml 的端口一致。
MILVUS_URI=http://127.0.0.1:19530
# 默认 Docker 配置关闭 Milvus 鉴权，因此可留空；启用鉴权后填写对应凭据。
MILVUS_USER=
MILVUS_PASSWORD=
# Collection 是向量索引的逻辑名称。改变 Embedding 维度时应使用新的名称重建索引。
COLLECTION_NAME=personalive_knowledge_v1

# ===== MySQL 应用数据库 =====
# Docker 默认把容器 3306 映射到本机 13306。
MYSQL_HOST=127.0.0.1
MYSQL_PORT=13306
MYSQL_DATABASE=personalive
MYSQL_USER=personalive
# 首次创建 MySQL 数据卷前改成强密码；已有数据卷不会因修改此值自动更新数据库密码。
MYSQL_PASSWORD=replace-with-mysql-password
MYSQL_ROOT_PASSWORD=replace-with-a-different-root-password

# ===== FastAPI 服务 =====
# 默认仅绑定本机回环地址，避免未配置认证时暴露资料和本地设置。
APP_HOST=127.0.0.1
APP_PORT=8001

# ===== RAG 流程控制 =====
# default 使用 Adaptive/Corrective RAG；simple 仅执行 retrieve -> generate。
RAG_PIPELINE=default
# 本地证据不足时最多改写查询次数，以及答案质量门最多生成重试次数。
MAX_REWRITE_COUNT=2
MAX_GENERATION_RETRY=2
# 批量证据评分低于该阈值时，答案会进入质量检查与纠错路径。
DEFAULT_CONFIDENCE_THRESHOLD=0.75
# 单文件上传大小上限（MB）。
MAX_UPLOAD_MB=50
